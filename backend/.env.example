# Security & Authentication
JWT_SECRET=cpms_secure_jwt_secret_token_adwt_2026_key
JWT_EXPIRES_IN=7d

# File Upload Settings (Local & Persistent Cloudinary)
MAX_FILE_SIZE=5242880 # 5MB in bytes
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
